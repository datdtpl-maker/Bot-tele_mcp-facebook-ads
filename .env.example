# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
# Comma-separated Telegram user IDs allowed to control the bot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Meta Marketing API
META_ACCESS_TOKEN=EAAB_replace_me
META_GRAPH_API_VERSION=v22.0

# Optional: default account used when a command omits act_<id>.
DEFAULT_AD_ACCOUNT_ID=act_1234567890
BOT_TIMEZONE=Asia/Bangkok

# OpenAI natural language understanding
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-5.4-mini

# Safety
# true = mutating actions only return dry-run previews unless a command explicitly supports live mode.
SAFE_MODE=true

# Google Sheets audit log
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=C:\secure\service-account.json
GOOGLE_SHEET_ID=replace_me
GOOGLE_SHEET_TAB=bot_logs

# Supabase chat/session context
SUPABASE_ENABLED=false
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_SESSION_TABLE=bot_sessions

# Optional Meta defaults for creating full funnel ad sets/ads.
# Meta budgets are in the ad account minor currency unit, e.g. 100000 = 1,000.00 VND or 1000 = $10.00.
DEFAULT_DAILY_BUDGET=100000
DEFAULT_TARGETING={"geo_locations":{"countries":["VN"]},"age_min":18,"age_max":55}
DEFAULT_PIXEL_ID=
DEFAULT_CONVERSION_EVENT=PURCHASE
